<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/emt_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recuérdame"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/emt_blue_dark"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Avísame cuando el bus se acerque a mi parada"
            android:textSize="14sp"
            android:textColor="#545454"
            android:layout_marginBottom="16dp" />

        <!-- ── Card: Configuración de alerta ── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardConfiguracion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="2dp"
            app:cardCornerRadius="8dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Parada favorita -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Parada favorita"
                    android:textStyle="bold"
                    android:textColor="@color/emt_blue_dark"
                    android:layout_marginBottom="8dp" />

                <Spinner
                    android:id="@+id/spinnerFavoritos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvSinFavoritos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No tienes paradas guardadas. Añade una desde el detalle de parada (icono ★)."
                    android:textColor="#D32F2F"
                    android:textSize="13sp"
                    android:visibility="gone"
                    android:layout_marginBottom="8dp" />

                <!-- Separador -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp" />

                <!-- Línea (opcional) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Línea (opcional)"
                    android:textStyle="bold"
                    android:textColor="@color/emt_blue_dark"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vacío = avisa con el primer bus que llegue"
                    android:textSize="12sp"
                    android:textColor="#6D6D6D"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etLinea"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Ej: 114"
                    android:textColorHint="#616161"
                    android:inputType="textCapCharacters"
                    android:maxLines="1"
                    android:layout_marginBottom="4dp" />

                <!-- Separador -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp" />

                <!-- Umbral de minutos -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Avisarme con antelación de:"
                    android:textStyle="bold"
                    android:textColor="@color/emt_blue_dark"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <SeekBar
                        android:id="@+id/seekBarMinutos"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="19"
                        android:progress="4" />

                    <TextView
                        android:id="@+id/tvMinutos"
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:text="5 min"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/emt_blue"
                        android:gravity="center"
                        android:layout_marginStart="12dp" />

                </LinearLayout>

                <Button
                    android:id="@+id/btnActivar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Activar alerta"
                    android:backgroundTint="@color/emt_blue" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ── Card: Estado de alerta activa ── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="3dp"
            app:cardCornerRadius="8dp"
            app:strokeColor="@color/emt_blue"
            app:strokeWidth="2dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_directions_bus"
                        app:tint="@color/emt_blue"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="Bus" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Alerta activa"
                        android:textStyle="bold"
                        android:textColor="@color/emt_blue"
                        android:textSize="16sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvEstado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Vigilando parada…"
                    android:textColor="#424242"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btnCancelar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cancelar alerta"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    app:strokeColor="@color/emt_blue"
                    android:textColor="@color/emt_blue" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
